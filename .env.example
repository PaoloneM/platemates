# Copy to .env and fill in. Never commit .env.

# -- Django ---------------------------------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
# true on a server reached only over HTTPS: session and CSRF cookies are never sent in clear.
DJANGO_SECURE_COOKIES=false
# The plane of a request without the X-PlateMates-Plane header that each Traefik sets
# (backend apps/core/planes.py): "admin" here (everything allowed), "public" on the server.
DEFAULT_PLANE=admin

# -- Database -------------------------------------------------------------------------------------
POSTGRES_DB=platemates
POSTGRES_USER=platemates
POSTGRES_PASSWORD=platemates
# Used by the backend when run natively (uv run). Docker Compose builds its own.
DATABASE_URL=postgres://platemates:platemates@localhost:5432/platemates
# Cache (rules, settings): Redis, shared by every process, then a short-lived copy in each
# process's memory. docker-compose points REDIS_URL at its own redis service.
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_TIMEOUT_SECONDS=43200
CACHE_MEMORY_TIMEOUT_SECONDS=10
# Real-time messages to the browsers (generation progress): their own Redis database, so that
# clearing the cache leaves them alone.
REALTIME_REDIS_URL=redis://localhost:6379/1

# -- Generative LLM -------------------------------------------------------------------------------
# Which model answers: "unsloth_studio" (local, the LLM_* values below), "openai_compatible" (any
# OpenAI-compatible server, LLM_* too) or "anthropic" (Claude, the ANTHROPIC_* values).
# "unsloth_studio" adds Studio-specific checks on top of "openai_compatible".
LLM_PROVIDER=unsloth_studio
LLM_BASE_URL=http://127.0.0.1:8888
# Unsloth Studio: Settings -> API keys.
LLM_API_KEY=
LLM_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
# Model that reads recipe photos; empty = same as LLM_MODEL (recommended: no model swap).
LLM_VISION_MODEL=

# Claude (LLM_PROVIDER=anthropic): key from console.anthropic.com > Settings > API Keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Model that reads recipe photos; empty = ANTHROPIC_MODEL.
ANTHROPIC_VISION_MODEL=

# -- Embeddings -----------------------------------------------------------------------------------
# "openai_compatible": the bundled services/embeddings (sentence-transformers) by default, or any
# OpenAI-compatible /v1/embeddings (the EMBEDDINGS_* values). "openai": OpenAI's API (OPENAI_*).
# Changing model re-embeds every recipe (embed_recipes): vectors of different models never mix.
EMBEDDINGS_PROVIDER=openai_compatible
EMBEDDINGS_BASE_URL=http://127.0.0.1:8100
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OpenAI (EMBEDDINGS_PROVIDER=openai): key from platform.openai.com > Settings > API keys.
OPENAI_API_KEY=
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# -- Authentication (Keycloak) --------------------------------------------------------------------
# Keycloak is the identity provider; Django is its OIDC client. `setup_keycloak` (or the
# keycloak-setup compose service) configures the realm from these values.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# Browsers reach Keycloak under /auth on the app's own address. This is where the backend
# calls it directly, when run natively; docker-compose overrides it.
KEYCLOAK_INTERNAL_URL=http://localhost:8180/auth
KEYCLOAK_REALM=platemates
OIDC_RP_CLIENT_ID=platemates-backend
# Shared by Django and the Keycloak client. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OIDC_RP_CLIENT_SECRET=
# Every URL the app is opened from (Keycloak accepts only these as login redirect targets).
# localhost and 127.0.0.1 are different origins to the browser: list both. Comma-separated.
APP_PUBLIC_URLS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080
# Emails of the application administrators (Keycloak realm role `admin`): they change the app's
# settings from Management > Settings. Comma-separated; setup_keycloak gives the role to exactly
# these accounts (once they exist) and takes it from anyone else. Applies at their next login.
APP_ADMINS=

# Monitoring (the public server's admin plane, docs/operations.md). Secrets generated by
# scripts/init_env.py; GRAFANA_URLS is where Grafana is served (its Keycloak redirect target),
# empty where there is no Grafana.
GRAFANA_OIDC_CLIENT_SECRET=
GRAFANA_URLS=
GRAFANA_DB_PASSWORD=
MONITORING_DB_PASSWORD=

# Social login: each provider is enabled only when its credentials are set. Re-run setup_keycloak
# after changing them. Redirect URI to register with each provider:
#   <app https URL>/auth/realms/${KEYCLOAK_REALM}/broker/<google|microsoft|apple>/endpoint
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple needs a paid Apple Developer account and an https redirect URI (no localhost).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Path, relative to the repository root, of the .p8 key. Keep it under secrets/ (gitignored).
APPLE_PRIVATE_KEY_FILE=

# Outgoing email for Keycloak (password reset, email verification). Without it, email/password
# accounts still work but cannot reset their password.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Web search for recipe campaigns (apps/curation): "studio" (the model's own search tool) or
# "searxng" (our SearXNG, compose profile `campaign`: docker compose --profile campaign up -d).
RECIPE_SEARCH=studio
SEARXNG_SECRET=

# Copy to .env and fill in. Never commit .env.

# -- Django ---------------------------------------------------------------------------------------
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

# -- Database -------------------------------------------------------------------------------------
POSTGRES_DB=mymenu
POSTGRES_USER=mymenu
POSTGRES_PASSWORD=mymenu
# Used by the backend when run natively (uv run). Docker Compose builds its own.
DATABASE_URL=postgres://mymenu:mymenu@localhost:5432/mymenu

# -- Generative LLM (any OpenAI-compatible server) -------------------------------------------------
# "unsloth_studio" adds Studio-specific checks on top of "openai_compatible".
LLM_PROVIDER=unsloth_studio
LLM_BASE_URL=http://127.0.0.1:8888
# Unsloth Studio: Settings -> API keys.
LLM_API_KEY=
LLM_MODEL=unsloth/Qwen3.6-35B-A3B-MTP-GGUF

# -- Embeddings (any OpenAI-compatible /v1/embeddings) ---------------------------------------------
# Default: the bundled services/embeddings (sentence-transformers). Unsloth Studio's own
# /v1/embeddings or a cloud API work too: change URL, key and model.
EMBEDDINGS_PROVIDER=openai_compatible
EMBEDDINGS_BASE_URL=http://127.0.0.1:8100
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

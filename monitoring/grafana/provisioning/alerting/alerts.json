{
 "apiVersion": 1,
 "templates": [
  {
   "orgId": 1,
   "name": "platemates",
   "template": "{{ define \"platemates.telegram\" -}}\n{{ range .Alerts.Firing -}}\n{{ if eq .Labels.severity \"critical\" }}🚨{{ else if eq .Labels.severity \"info\" }}🔔{{ else }}⚠️{{ end }} <b>{{ .Labels.alertname }}</b>\n{{ .Annotations.summary }}\n{{ if .Annotations.action }}👉 {{ .Annotations.action }}\n{{ end }}<a href=\"{{ .GeneratorURL }}\">Apri in Grafana</a>\n\n{{ end -}}\n{{ range .Alerts.Resolved -}}\n✅ <b>Risolto: {{ .Labels.alertname }}</b>\n\n{{ end -}}\n{{- end }}"
  }
 ],
 "policies": [
  {
   "orgId": 1,
   "receiver": "telegram",
   "group_by": [
    "alertname"
   ],
   "group_wait": "30s",
   "group_interval": "5m",
   "repeat_interval": "12h"
  }
 ],
 "groups": [
  {
   "orgId": 1,
   "name": "platemates",
   "folder": "PlateMates",
   "interval": "1m",
   "rules": [
    {
     "uid": "pm-backup-stale",
     "title": "Backup fermo da più di 26 ore",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "time() - platemates_backup_last_success_timestamp_seconds",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            93600
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "Alerting",
     "execErrState": "Error",
     "for": "10m",
     "annotations": {
      "summary": "L'ultimo backup riuscito è di {{ humanizeDuration $values.B.Value }} fa.",
      "action": "Controlla sul server: journalctl -u platemates-backup"
     },
     "labels": {
      "severity": "critical"
     },
     "isPaused": false
    },
    {
     "uid": "pm-wal-archive",
     "title": "Archiviazione del WAL in errore",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "increase(pg_stat_archiver_failed_count[15m])",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "5m",
     "annotations": {
      "summary": "PostgreSQL non riesce a salvare il WAL in pgBackRest ({{ printf \"%.0f\" $values.B.Value }} errori in 15 minuti): il ripristino a un istante preciso è a rischio.",
      "action": "Controlla i log del servizio db sul server."
     },
     "labels": {
      "severity": "critical"
     },
     "isPaused": false
    },
    {
     "uid": "pm-postgres-down",
     "title": "Database non raggiungibile",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "pg_up",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "lt",
           "params": [
            1
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "Alerting",
     "execErrState": "Error",
     "for": "2m",
     "annotations": {
      "summary": "PostgreSQL non risponde da 2 minuti.",
      "action": "Controlla il servizio db sul server."
     },
     "labels": {
      "severity": "critical"
     },
     "isPaused": false
    },
    {
     "uid": "pm-disk",
     "title": "Disco quasi pieno",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            85
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "10m",
     "annotations": {
      "summary": "Disco del server al {{ printf \"%.0f\" $values.B.Value }}%.",
      "action": "Libera spazio (immagini Docker vecchie, log) o ingrandisci il disco."
     },
     "labels": {
      "severity": "warning"
     },
     "isPaused": false
    },
    {
     "uid": "pm-memory",
     "title": "Memoria quasi esaurita",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "100 * node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "lt",
           "params": [
            10
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "10m",
     "annotations": {
      "summary": "Memoria libera al {{ printf \"%.0f\" $values.B.Value }}% da 10 minuti.",
      "action": "Guarda la dashboard Containers per capire chi la usa."
     },
     "labels": {
      "severity": "warning"
     },
     "isPaused": false
    },
    {
     "uid": "pm-target-down",
     "title": "Servizio non raggiungibile",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "up",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "lt",
           "params": [
            1
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "5m",
     "annotations": {
      "summary": "{{ $labels.job }} ({{ $labels.instance }}) non risponde da 5 minuti.",
      "action": "Controlla quel servizio sul server."
     },
     "labels": {
      "severity": "critical"
     },
     "isPaused": false
    },
    {
     "uid": "pm-public-5xx",
     "title": "Errori sul sito pubblico",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "victoriametrics",
       "model": {
        "refId": "A",
        "expr": "sum(rate(traefik_service_requests_total{plane=\"public\",code=~\"5..\"}[5m]))",
        "instant": true
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0.05
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "5m",
     "annotations": {
      "summary": "Il sito risponde con errori del server (5xx): {{ printf \"%.2f\" $values.B.Value }} al secondo negli ultimi 5 minuti.",
      "action": "Guarda i log del backend e la dashboard Traffic."
     },
     "labels": {
      "severity": "warning"
     },
     "isPaused": false
    },
    {
     "uid": "pm-invite-requests",
     "title": "Richieste d'invito in attesa",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "platemates-db",
       "model": {
        "refId": "A",
        "rawSql": "SELECT COUNT(*) AS value FROM accounts_inviterequest WHERE status = 'pending'",
        "format": "table",
        "rawQuery": true,
        "editorMode": "code"
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            0
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "0s",
     "annotations": {
      "summary": "Richieste in attesa: {{ printf \"%.0f\" $values.B.Value }}.",
      "action": "Vedi Gestione → Richieste d'invito, sul piano admin."
     },
     "labels": {
      "severity": "info"
     },
     "isPaused": false
    },
    {
     "uid": "pm-ai-cost",
     "title": "Spesa AI oltre 5 USD oggi",
     "condition": "C",
     "data": [
      {
       "refId": "A",
       "relativeTimeRange": {
        "from": 900,
        "to": 0
       },
       "datasourceUid": "platemates-db",
       "model": {
        "refId": "A",
        "rawSql": "SELECT COALESCE(SUM((u.input_tokens * p.input_per_mtok + u.output_tokens * p.output_per_mtok\n  + u.cache_read_tokens * p.cache_read_per_mtok + u.cache_write_tokens * p.cache_write_per_mtok)\n  / 1000000 + u.web_searches * p.per_thousand_searches / 1000), 0) AS value\nFROM usage_aiusage u JOIN usage_modelprice p ON p.model = u.model\nWHERE u.created_at >= date_trunc('day', now())",
        "format": "table",
        "rawQuery": true,
        "editorMode": "code"
       }
      },
      {
       "refId": "B",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last"
       }
      },
      {
       "refId": "C",
       "datasourceUid": "__expr__",
       "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [
         {
          "evaluator": {
           "type": "gt",
           "params": [
            5
           ]
          }
         }
        ]
       }
      }
     ],
     "noDataState": "OK",
     "execErrState": "Error",
     "for": "0s",
     "annotations": {
      "summary": "Spesa AI stimata di oggi: {{ printf \"%.2f\" $values.B.Value }} USD.",
      "action": "Vedi Gestione → Consumi, sul piano admin."
     },
     "labels": {
      "severity": "warning"
     },
     "isPaused": false
    }
   ]
  }
 ]
}

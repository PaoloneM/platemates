{
 "uid": "pm-containers",
 "title": "Containers",
 "tags": [
  "platemates"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "CPU by container",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (rate(platemates_container_cpu_seconds_total[5m]))",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 10
   }
  },
  {
   "type": "timeseries",
   "title": "Memory by container",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (name) (platemates_container_memory_bytes)",
     "legendFormat": "{{name}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 10
   }
  }
 ]
}

{
 "uid": "pm-traffic",
 "title": "Traffic",
 "tags": [
  "platemates"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Requests per second, by service",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(traefik_service_requests_total[5m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Server errors (5xx) per second",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(traefik_service_requests_total{code=~\"5..\"}[5m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Latency, 95th percentile",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (service, le) (rate(traefik_service_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 3,
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "Client errors (4xx) per second",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service) (rate(traefik_service_requests_total{code=~\"4..\"}[5m]))",
     "legendFormat": "{{service}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   }
  }
 ]
}

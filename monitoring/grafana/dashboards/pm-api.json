{
 "uid": "pm-api",
 "title": "API",
 "tags": [
  "platemates"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "1m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "panels": [
  {
   "type": "bargauge",
   "title": "95th percentile by endpoint (slowest 15, over the range)",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, histogram_quantile(0.95, sum by (view, method, le) (rate(platemates_http_request_duration_seconds_bucket[$__range]))))",
     "legendFormat": "{{method}} {{view}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     },
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 10
   }
  },
  {
   "type": "timeseries",
   "title": "Latency, 95th percentile, by endpoint",
   "datasource": {
    "type": "prometheus",
    "uid": "victoriametrics"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (view, method, le) (rate(platemates_http_request_duration_seconds_bucket[15m])))",
     "legendFormat": "{{method}} {{view}}",
     "datasource": {
      "type": "prometheus",
      "uid": "victoriametrics"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   },
   "id": 2,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 12,
    "h": 8
   }
  },
  {
